{
  "name": "console-band-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.7.0"
  },
  "pinnedBelowLatest": {
    "_": "Constitution §4 wants the newest stable of everything. These two are deliberately older, same pins and reasons as netpano and derinbay-com. npm ignores this field.",
    "typescript": {
      "pinned": "6.0.3",
      "latest": "7.0.2 at 2026-11-06",
      "why": "typescript-eslint peers on typescript <6.1.0, so eslint-config-next cannot load under TS 7 and `npm run lint` dies.",
      "tracking": "https://github.com/typescript-eslint/typescript-eslint/issues/10940",
      "unpinWhen": "typescript-eslint ships TS 7 support; then bump typescript and typescript-eslint in one commit and re-run the full chain."
    },
    "eslint": {
      "pinned": "9.39.5",
      "latest": "10.14.0 at 2026-11-06",
      "why": "eslint-config-next depends on eslint-plugin-react and eslint-plugin-import, whose newest releases still call APIs ESLint 10 removed.",
      "tracking": "https://github.com/jsx-eslint/eslint-plugin-react/issues",
      "unpinWhen": "eslint-plugin-react and eslint-plugin-import both support ESLint 10; then bump eslint and @eslint/js in one commit and re-run the full chain."
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "check:size": "node scripts/check-js-size.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --reporter=dot",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --reporter=line"
  },
  "dependencies": {
